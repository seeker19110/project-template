npx lint-staged

# Quét bí mật TRƯỚC khi commit (audit 2026-09-12, F-005): workflow secret-scan.yml chỉ bắt ở CI,
# tức bí mật đã nằm trong lịch sử Git rồi mới bị phát hiện — và xoá khỏi lịch sử là việc đau đớn.
# Chỉ quét phần STAGED, không quét cả lịch sử → nhanh, chạy được mỗi lần commit.
# Bỏ qua có chủ đích: SKIP_SECRET_SCAN=1 git commit ...
if [ "${SKIP_SECRET_SCAN:-0}" != "1" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact --no-banner || {
      echo "🚫 Phát hiện bí mật trong phần staged — KHÔNG commit."
      echo "   Gỡ bí mật ra biến môi trường (CLAUDE.md §3.5), rồi commit lại."
      echo "   Nếu là dương tính giả: thêm vào .gitleaksignore, hoặc SKIP_SECRET_SCAN=1 git commit ..."
      exit 1
    }
  else
    # Fail-open CÓ CẢNH BÁO (quy ước docs/CONVENTIONS.md §A) — không chặn commit vì thiếu công cụ,
    # nhưng phải nói ra để người dùng biết mình đang thiếu một lớp bảo vệ.
    echo "⚠️  gitleaks chưa được cài → BỎ QUA quét bí mật ở pre-commit."
    echo "   Cài: brew install gitleaks | scoop install gitleaks | https://github.com/gitleaks/gitleaks/releases"
    echo "   (CI vẫn quét qua .github/workflows/secret-scan.yml, nhưng lúc đó bí mật đã vào lịch sử.)"
  fi
fi

bash scripts/dev-task.sh gate
